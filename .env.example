# --- Local mode (default): nothing leaves your machine ---
AI_PROVIDER=ollama
DOORSTEP_MODEL=qwen2.5:1.5b-instruct
OLLAMA_URL=http://127.0.0.1:11434
MODEL_TIMEOUT_S=45
DOORSTEP_DB=doorstep.db

# Embeddings (semantic memory + novelty). auto = Ollama in local mode, hashed vectors in hosted mode
EMBED_PROVIDER=auto
EMBED_MODEL=all-minilm

# --- Hosted mode (e.g. Render + Groq). Set these in the host's dashboard, never in git ---
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=<set in host dashboard>
# DOORSTEP_MODEL=openai/gpt-oss-20b
# MODEL_TIMEOUT_S=60
# FRONTEND_URL=https://doorstep-alpha.vercel.app
# Frontend build env (Vercel): VITE_API_URL=https://doorstep-api-nxi5.onrender.com